+    let parameters = json!({"create":true,"type":"Part::Helix","name":"Helix",
+        "helix_reference":{"source":"ProjectedCircle","source_id":"9007199254740993",
+            "subelement":"Edge1","mapped_name":"stable-circle","face_binder":"HF","edge_binder":"HC",
+            "reference_mode":"Circle","extent_mode":"Height and pitch"},
+        "properties":{"Height":{"quantity_input":"2 in","default_unit":"in"},
+            "Pitch":{"quantity_input":"5 mm","default_unit":"mm"},"StartAngle":0.,"MapReversed":true},
+        "expressions":{}});
+    let edits = crate::property_commands::build(&parameters).unwrap();
+    assert_eq!(edits[0]["reference_mode"], "Circle");
+    assert_eq!(edits[0]["extent_mode"], "Height and pitch");
+    assert_eq!(edits[0]["source_id"], "9007199254740993");
+    assert!(!edits.iter().any(|e| e["property"] == "Turns"));
+    assert!(edits.iter().any(|e| e["property"] == "Pitch"));
+    assert!(edits.iter().any(|e| e["property"] == "Height"));
